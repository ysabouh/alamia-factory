APP_NAME="MyFactory ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/myfactory
FRONTEND_URL=http://localhost/myfactory

# أصول CORS للواجهة (مفصولة بفاصلة). الافتراضي في config/cors.php كافٍ لـ Next على 3010
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:3010,http://localhost:3010

# محلي فقط (مع APP_ENV=local): قراءة workforce/meta و workforce/employees بدون توكن — false لإلزام Sanctum
WORKFORCE_PUBLIC_READ=true

# حساب المدير الثابت (محلي) — يُعاد ضبطه بـ php artisan factory:ensure-superadmin
# FACTORY_SUPERADMIN_EMAIL=admin@myfactory.local
# FACTORY_SUPERADMIN_PASSWORD=Admin@2026

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myfactory
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=database
SESSION_DRIVER=file
CACHE_STORE=database

REVERB_APP_ID=myfactory
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
