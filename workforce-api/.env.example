# Same MySQL server & database as Laravel backend (backend/.env: DB_DATABASE, etc.).
# Schema is owned by Laravel migrations — run first: php artisan migrate
#
# Empty password (XAMPP): mysql://root@127.0.0.1:3306/myfactory
# With password: mysql://root:PASSWORD@127.0.0.1:3306/myfactory (URL-encode special chars in PASSWORD)
DATABASE_URL="mysql://root@127.0.0.1:3306/myfactory"
PORT=4000
